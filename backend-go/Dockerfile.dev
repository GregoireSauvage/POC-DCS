# Dev Dockerfile for Go backend with hot reload
FROM golang:1.24-alpine AS dev

WORKDIR /app

# Install dev tools (air moved to github.com/air-verse/air)
RUN go install github.com/air-verse/air@v1.60.0

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source
COPY . .

# Use air for hot reload in dev
CMD ["air", "-c", ".air.toml"]
